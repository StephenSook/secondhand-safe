{
  "expo": {
    "name": "Lullabuy",
    "slug": "lullabuy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "tech.lullabuy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "tech.lullabuy.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lullabuy reads the product label from a photo you choose.",
          "cameraPermission": "Lullabuy photographs the product label to check it against federal recalls.",
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "lullabuy",
    "extra": {
      "eas": {
        "projectId": "cc2f2925-e4a2-4dce-be62-5b1c77b4437f"
      }
    },
    "owner": "stephensook"
  }
}
