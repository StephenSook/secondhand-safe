# Keep deploy uploads to what the Next.js build reads.
ml/.venv
ml/data
ml/out/*
!ml/out/metrics.json
!ml/out/split.json
ml/*.py
ml/*.csv
ml/requirements*.txt
data/*.py
data/__pycache__
docs/*
!docs/FACTS.json
tests
scripts/*
!scripts/copy-maplibre.mjs
test-results
playwright-report
*.log

# The Expo app deploys through Expo, not Vercel
mobile
