# Visa Acceptance sandbox (developer.visaacceptance.com). Sandbox keys only.
VISA_MERCHANT_ID=
VISA_KEY_ID=
VISA_SECRET_KEY=
VISA_HOST=apitest.cybersource.com
# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=secondhand_safe
# Google Gemini (AI Studio)
GEMINI_API_KEY=
# ElevenLabs
ELEVENLABS_API_KEY=
# ElevenLabs voice agent: the agent id printed by scripts/elevenlabs-agent.mjs, and the shared secret its
# search webhook sends in the x-lullabuy-agent header (any long random string, e.g. openssl rand -hex 32)
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_SECRET=
# Trusted Agent Protocol agent key (Ed25519, hex private key) and its key id
TAP_AGENT_PRIVATE_KEY_HEX=
TAP_AGENT_KEY_ID=
# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY_B58=
# Metaplex Core passport mints per UTC day across every instance (0 turns minting off; default 50)
PASSPORT_DAILY_CAP=50
# Visa Direct push payout (developer.visa.com project, two-way SSL). PEM values are the full text of each file;
# on one line, write the newlines as \n. VISA_DIRECT_CA is the VDP Root CA and Issuing CA concatenated.
VISA_DIRECT_USER_ID=
VISA_DIRECT_PASSWORD=
VISA_DIRECT_CERT=
VISA_DIRECT_KEY=
VISA_DIRECT_CA=
VISA_DIRECT_HOST=sandbox.api.visa.com
# Optional: the test acquiring BIN shown in your VDP project dashboard (default 408999, from Visa's sandbox sample)
VISA_DIRECT_ACQUIRING_BIN=
# Optional: the sandbox recipient test card from your VDP project's Test Data page (the default is a Visa sandbox test card)
VISA_DIRECT_RECIPIENT_PAN=
# Message Level Encryption (the push endpoint answers 400 / 9125 without it): VDP project > Message Level Encryption >
# Generate Key-ID, then the server encryption certificate and the MLE private key for that Key-ID (PEM text)
VISA_DIRECT_MLE_KEY_ID=
VISA_DIRECT_MLE_SERVER_CERT=
VISA_DIRECT_MLE_PRIVATE_KEY=
# Deployed URL (for NFC passport links, TAP authority)
PUBLIC_BASE_URL=

# Hold sweeper (PLAN 5.4): Vercel Cron sends Authorization: Bearer $CRON_SECRET; holds older than the window are released
CRON_SECRET=generate-with-openssl-rand-hex-32
HOLD_WINDOW_HOURS=24

# Recall watch Web Push (PLAN 6.2): a VAPID key pair (npx web-push generate-vapid-keys) and a contact URL or mailto
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://lullabuy.tech
# Voice agent sessions per UTC day across every instance (0 turns voice off; default 60)
VOICE_DAILY_CAP=60
# Look-alike search: cosine similarity at or above this counts as a strong match (default 0.93)
LOOKALIKE_STRONG_COSINE=0.93
# Recall call (PLAN 6.12): Lullabuy phones an opted-in buyer when their hold is reversed for a recall or banned type.
# Its OWN Vonage application (voice capability, keypair generated locally); the private key is the full PEM
# (literal \n escapes or base64 are accepted). FROM is a number the Vonage account owns (used as caller id only).
RECALL_CALL_VONAGE_APPLICATION_ID=
RECALL_CALL_VONAGE_PRIVATE_KEY=
RECALL_CALL_FROM_NUMBER=
# seals opted-in numbers (AES-256-GCM) and signs the callback URLs: openssl rand -hex 32
RECALL_CALL_SECRET=
# calls per UTC day across the whole deployment (default 60, max 500; fails closed at the cap); each number gets at most 6 a day
RECALL_CALL_DAILY_CAP=60
# /get/ios: the public TestFlight invite link (https://testflight.apple.com/join/...). Unset: the page says the link is
# waiting on Apple's beta review and offers the web app and the Android APK instead.
TESTFLIGHT_PUBLIC_URL=
