# Visa Acceptance sandbox (developer.visaacceptance.com). Sandbox keys only.
VISA_MERCHANT_ID=
VISA_KEY_ID=
VISA_SECRET_KEY=
VISA_HOST=apitest.cybersource.com
# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=secondhand_safe
# Google Gemini (AI Studio)
GEMINI_API_KEY=
# ElevenLabs
ELEVENLABS_API_KEY=
# ElevenLabs voice agent: the agent id printed by scripts/elevenlabs-agent.mjs, and the shared secret its
# search webhook sends in the x-lullabuy-agent header (any long random string, e.g. openssl rand -hex 32)
ELEVENLABS_AGENT_ID=
ELEVENLABS_TOOL_SECRET=
# Trusted Agent Protocol agent key (Ed25519, hex private key) and its key id
TAP_AGENT_PRIVATE_KEY_HEX=
TAP_AGENT_KEY_ID=
# Solana devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_SECRET_KEY_B58=
# Metaplex Core passport mints per UTC day across every instance (0 turns minting off; default 50)
PASSPORT_DAILY_CAP=50
# Deployed URL (for NFC passport links, TAP authority)
PUBLIC_BASE_URL=

# Hold sweeper (PLAN 5.4): Vercel Cron sends Authorization: Bearer $CRON_SECRET; holds older than the window are released
CRON_SECRET=generate-with-openssl-rand-hex-32
HOLD_WINDOW_HOURS=24

# Recall watch Web Push (PLAN 6.2): a VAPID key pair (npx web-push generate-vapid-keys) and a contact URL or mailto
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://lullabuy.tech
# Voice agent sessions per UTC day across every instance (0 turns voice off; default 60)
VOICE_DAILY_CAP=60
# Look-alike search: cosine similarity at or above this counts as a strong match (default 0.93)
LOOKALIKE_STRONG_COSINE=0.93
